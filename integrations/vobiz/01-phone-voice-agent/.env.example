# Speechmatics API key (required), used for agent STT and Text to Speech
# Get yours at: https://portal.speechmatics.com/
SPEECHMATICS_API_KEY=your_speechmatics_api_key_here

# LLM (required). Any OpenAI-compatible chat completions endpoint works.
# The default is Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.1-flash-lite
# Set to an empty value for models that reject the reasoning_effort field.
# LLM_REASONING_EFFORT=minimal
# To use another provider instead, set LLM_BASE_URL, LLM_MODEL and LLM_API_KEY.
# LLM_API_KEY=

# Public https:// URL that forwards to http://127.0.0.1:PORT (required).
# Vobiz fetches the answer URL and opens the audio WebSocket through it.
PUBLIC_URL=https://your-tunnel.example.com
# PORT=8765

# Optional: a fixed secret path segment. A random one is generated per run if unset.
# PATH_TOKEN=

# Optional: agent STT region endpoint (the SDK adds /agent)
# SPEECHMATICS_RT_URL=wss://eu2.rt.speechmatics.com/v2

# Optional voice and language
# SM_VOICE=sarah          # sarah, theo (UK English) - megan, jack (US English)
# SM_LANGUAGE=en

# Vobiz account and number, used by dial.py to place outbound calls
# Find these in the Vobiz console: https://console.vobiz.ai/
VOBIZ_AUTH_ID=your_vobiz_auth_id
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token
VOBIZ_FROM_NUMBER=+910000000000
