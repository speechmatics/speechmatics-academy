# Speechmatics API key (required), used for agent STT and the default Text to Speech
# Get yours at: https://portal.speechmatics.com/
SPEECHMATICS_API_KEY=your_speechmatics_api_key_here

# LLM (required). Any OpenAI-compatible chat completions endpoint works.
# Set up ONE of the options below.

# Option A (default): Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.1-flash-lite
# Set to an empty value for models that reject the reasoning_effort field.
# LLM_REASONING_EFFORT=minimal

# Option B: OpenAI (ChatGPT models). Get a key at https://platform.openai.com/api-keys
# Uncomment these four lines and remove GEMINI_API_KEY above.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4.1-mini
# LLM_REASONING_EFFORT=
# Keep LLM_REASONING_EFFORT empty: gpt-4.1 and gpt-4o models reject that field.
# For a reasoning model (GPT-5 and later, such as gpt-6-luna), set instead:
#   LLM_TEMPERATURE=default    (they accept only their default temperature)
#   LLM_REASONING_EFFORT=none  (reasoning delays the first word on a call)

# Any other OpenAI-compatible provider: set LLM_BASE_URL, LLM_MODEL and LLM_API_KEY.

# Text to Speech for the agent's voice (required). Choose ONE provider with TTS_PROVIDER.
# Every option streams 16 kHz PCM straight into the call.

# Option A (default): Speechmatics TTS. Uses SPEECHMATICS_API_KEY; pick a voice with SM_VOICE below.
TTS_PROVIDER=speechmatics

# Option B: ElevenLabs. Get a key at https://elevenlabs.io/app/settings/api-keys
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here   # the secret key, starting with sk_
# ELEVENLABS_MODEL=eleven_flash_v2_5   # or eleven_v4_turbo for more expressive speech
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # George

# Option C: Cartesia. Get a key at https://play.cartesia.ai/keys
# TTS_PROVIDER=cartesia
# CARTESIA_API_KEY=your_cartesia_api_key_here
# CARTESIA_MODEL=sonic-3.6
# CARTESIA_VOICE_ID=62ae83ad-4f6a-430b-af41-a9bede9286ca   # Gemma (UK English)

# Public https:// URL that forwards to http://127.0.0.1:PORT (required).
# Vobiz fetches the answer URL and opens the audio WebSocket through it.
PUBLIC_URL=https://your-tunnel.example.com
# PORT=8765

# Optional: a fixed secret path segment. A random one is generated per run if unset.
# PATH_TOKEN=

# Optional: agent STT region endpoint (the SDK adds /agent)
# SPEECHMATICS_RT_URL=wss://eu2.rt.speechmatics.com/v2

# Optional limits: calls handled at once, and the longest a call can last in seconds
# MAX_CALLS=5
# MAX_CALL_SECONDS=600

# Optional voice (Speechmatics TTS only) and transcription language
# SM_VOICE=sarah          # sarah, theo (UK English) - megan, jack (US English)
# SM_LANGUAGE=en

# Vobiz account and number, used by dial.py to place outbound calls
# Find these in the Vobiz console: https://console.vobiz.ai/
VOBIZ_AUTH_ID=your_vobiz_auth_id
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token
VOBIZ_FROM_NUMBER=+910000000000
