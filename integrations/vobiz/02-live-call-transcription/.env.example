# Copy to .env and fill in your values.

# Speechmatics API key. https://portal.speechmatics.com/
SPEECHMATICS_API_KEY=your_speechmatics_api_key_here

# ngrok auth token, used to expose the local server so Vobiz can reach it.
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Optional. If you already run a tunnel (cloudflared, your own reverse proxy),
# set its https:// URL here; ngrok is then not started and NGROK_AUTHTOKEN is
# not needed. It must forward to localhost:SM_VOBIZ_PROXY_PORT.
PUBLIC_URL=

# Vobiz credentials + the E.164 number that receives inbound calls. On
# startup the proxy attaches this number to a Vobiz application named
# "speechmatics-transcription-<number digits>" whose answer URL points at the
# ngrok tunnel. (With --call it places an outbound call instead and leaves
# the number's routing alone.)
# The number is not switched back on shutdown: the proxy prints the
# application it was attached to before, so you can re-attach it.
# Find these in the Vobiz console: https://console.vobiz.ai/
VOBIZ_AUTH_ID=your_vobiz_auth_id
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token
VOBIZ_PHONE_NUMBER=+910000000000

# E.164 number the <Dial> bridges the caller to - the second human in
# the two-party conversation being transcribed.
FORWARD_TO_NUMBER=+910000000001

# Optional. Transcription language code, for example "hi" for Hindi.
# See https://docs.speechmatics.com/speech-to-text/languages. Default: en.
SPEECHMATICS_LANGUAGE=en

# Optional. Local server port. Default: 5000.
SM_VOBIZ_PROXY_PORT=5000

# Optional. Longest a bridged call can last, in seconds. Default: 3600.
# MAX_CALL_SECONDS=3600
