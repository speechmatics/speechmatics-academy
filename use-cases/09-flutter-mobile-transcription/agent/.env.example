# Copy to .env.local, which is ignored by Git and Docker.
# LiveKit Cloud injects its own worker credentials when the agent is deployed.
# Local token issuer needs credentials for the same verified LiveKit project.
LIVEKIT_URL=wss://speechmatics-58s7pbzh.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Token issuer only: a long random access token entered into Agent setup on the phone.
# Leave blank until securely configured; /token fails closed without it.
EVERYVOICE_APP_TOKEN=

# Keep this name identical in the worker, token issuer and mobile Agent setup.
EVERYVOICE_AGENT_NAME=everyvoice-agent
EVERYVOICE_STT_LANGUAGE=en
EVERYVOICE_LLM_MODEL=openai/gpt-4.1-mini
EVERYVOICE_TTS_MODEL=cartesia/sonic-3
EVERYVOICE_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
# Optional base instructions; phone personality preferences are appended per session.
# EVERYVOICE_INSTRUCTIONS="You are EveryVoice. Be warm, clear, and concise."

# No Speechmatics, OpenAI, or Cartesia provider API keys are required for this agent.
